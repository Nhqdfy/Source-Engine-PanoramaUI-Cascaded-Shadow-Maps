<?xml version="1.0" encoding="utf-8"?>
<!-- SE port (2026-09-22): 自创"背包"面板 —— 塔科夫风格的网格容器。
     JS 侧（scripts/se_backpack.js）按物品尺寸逐个占格，悬停显示详情。

     载入方式（两种都行）：
       * 游戏内/桌面控制台 `se_backpack`  —— 引擎建的独立视图（engine/panoramaenginehandler.cpp）
       * 开发期 `panorama_menu se_backpack.xml` —— 复用主菜单的托管视图

     注意：panorama 要求 <scripts> 必须写在任何子面板之前，否则整个布局加载失败。 -->
<root>
	<scripts>
		<include src="file://{resources}/scripts/se_backpack.js" />
	</scripts>

	<!-- 全屏遮罩：游戏内压暗背景，让窗口读起来像"打开了容器" -->
	<Panel id="SePackRoot" style="width: 100%; height: 100%; background-color: #00000073;">
		<Panel id="SePackWindow" style="width: 1064px; height: 664px; align: center center; background-color: #131518ff; border: 1px solid #454d57ff;">

			<!-- 标题栏 -->
			<Panel id="SePackHeader" style="width: 100%; height: 46px; background-color: #1d2229ff; flow-children: right;">
				<Label id="SePackTitle" style="margin-left: 18px; vertical-align: center; font-size: 22px; color: #dae0e6ff;" text="背包" />
				<Label id="SePackSubtitle" style="margin-left: 16px; vertical-align: center; font-size: 14px; color: #79838dff;" text="" />
				<Panel style="width: fill-parent-flow( 1.0 ); height: 100%;" />
				<Label id="SePackClose" style="margin-right: 12px; vertical-align: center; font-size: 18px; color: #9aa4aeff; padding: 8px;" text="X" />
			</Panel>

			<!-- 网格：JS 往里填背景格与物品，坐标用 x/y 偏移（父容器 flow-children: none） -->
			<Panel id="SePackGrid" style="flow-children: none; width: 720px; height: 480px; x: 16px; y: 62px;" />

			<!-- 悬停详情（浮层，默认隐藏） -->
			<Panel id="SePackDetails" style="x: 752px; y: 62px; width: 296px; height: 480px; background-color: #1a1f24ff; border: 1px solid #333b44ff; flow-children: down; visibility: collapse;">
				<Label id="SePackDetailName" style="width: 100%; margin: 16px 16px 6px 16px; font-size: 20px; color: #e7ebefff;" text="" />
				<Label id="SePackDetailRarity" style="width: 100%; margin: 0px 16px; font-size: 14px; color: #8e98a2ff;" text="" />
				<Image id="SePackDetailImage" style="width: 240px; height: 150px; margin: 10px 16px; background-color: #0e1013ff;" />
				<Label id="SePackDetailMeta" style="width: 100%; margin: 6px 16px; font-size: 14px; color: #98a2acff;" text="" />
				<Label id="SePackDetailHint" style="width: 100%; margin: 12px 16px 0px 16px; font-size: 13px; color: #6b757fff;" text="滚轮翻页 · 点 X 关闭" />
			</Panel>

			<!-- 底部状态栏 -->
			<Panel id="SePackFooter" style="width: 100%; height: 28px; y: 636px; background-color: #191d22ff; flow-children: right;">
				<Label id="SePackFooterText" style="margin-left: 18px; vertical-align: center; font-size: 13px; color: #6f7982ff;" text="" />
			</Panel>
		</Panel>
	</Panel>
</root>
