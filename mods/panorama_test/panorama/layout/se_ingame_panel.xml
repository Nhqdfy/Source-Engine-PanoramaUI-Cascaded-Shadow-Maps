<?xml version="1.0" encoding="utf-8"?>
<!-- SE port (2026-09-22): 地图内 panorama 面板测试（用户要求"写一个面板测试在地图是什么效果"）。
     用测试视图加载（引擎侧 CreatePanoramaTestView，-panoramatest / panorama_test 命令）——
     那个视图是唯一**进游戏关卡不会被自动隐藏**的托管视图（主菜单视图在 cl.IsActive() 时会被藏起来）。

     mods\panorama_test\panorama\layout\test.xml 现在用 <Frame> 指向本文件，
     所以 `-panoramatest` 加载的就是这个面板。

     要看的东西：
       1. 面板能不能在地图画面上叠加渲染（不是被 VGUI/引擎盖掉）
       2. 半透明混合对不对（#000000a6 的黑底应该透出地图）
       3. 坐标/缩放对不对（左上的框、正中准星框、右上的圆点）
       4. JS 能不能在地图内跑（每秒刷新的心跳行）
-->
<root>
	<scripts>
		<include src="file://{resources}/scripts/se_ingame_panel.js" />
	</scripts>

	<!-- 注意：<root> 下面最顶层的 panel 不能带 id —— panorama 会报
	     "Top most panel should not have an ID. This ID is set in code" 并导致整个布局解析失败。 -->
	<!-- 字体：只能用自定义 DirectWrite 字体集合（由 panorama/fonts/*.vfont 构建）里的族名 ——
	     Stratum2（拉丁）/ 'Noto Sans SC'（中文）/ 'Noto Mono'。
	     2026-09-22 踩坑：写 notosans（小写无空格）不是族名；写 'Arial Unicode MS' 虽是系统字体
	     但不在这个集合里 → 两个字都解析不到 → 字形全空、每行文字只剩占位色块。
	     可用的族名见 mods/panorama_test/panorama/layout/se_font_test.xml 的注释（那是字体冒烟布局）。 -->
	<Panel style="width: 100%; height: 100%; font-family: Stratum2, 'Noto Sans SC';">

		<!-- 左上：HUD 风格信息框 -->
		<Panel id="SeIgBox" style="x: 40px; y: 40px; width: 470px; height: 250px; background-color: #000000a6; border: 2px solid #00ff88ff; flow-children: down;">
			<Label style="margin: 10px 14px 2px 14px; font-family: Stratum2, 'Noto Sans SC'; font-size: 22px; color: #00ff88ff;" text="SE panel test / SE 面板测试" />
			<Label id="SeIgInfo" style="margin: 2px 14px; font-family: Stratum2, 'Noto Sans SC'; font-size: 16px; color: #ffffffff;" text="tick 1 / 心跳等待中..." />
			<Label id="SeIgInfo2" style="margin: 2px 14px; font-family: Stratum2, 'Noto Sans SC'; font-size: 15px; color: #c3ccd4ff;" text="size / 尺寸" />
			<Panel style="width: 100%; height: fill; flow-children: right;">
				<Panel style="width: 64px; height: 64px; margin: 14px; background-color: #ff3b30ff;" />
				<Panel style="width: 64px; height: 64px; margin: 14px; background-color: #34c759ff;" />
				<Panel style="width: 64px; height: 64px; margin: 14px; background-color: #0a84ffff;" />
			</Panel>
		</Panel>

		<!-- 屏幕正中：准星位置的标记框（看它是否挡住准星、定位是否居中） -->
		<Panel style="align: center center; width: 160px; height: 160px; border: 2px solid #ff3b30cc;" />

		<!-- 右上角：色块（看 100% 定位在右上是否正确） -->
		<Panel style="x: 100%-80px; y: 24px; width: 48px; height: 48px; background-color: #ffcc00ff;" />

		<!-- 左下角：细长条（看边缘对齐） -->
		<Panel style="x: 24px; y: 100%-40px; width: 320px; height: 16px; background-color: #af52deff;" />
	</Panel>
</root>
