				"base": "$gcc",
				"fileLocation": [
					"relative",
					"${workspaceFolder}/build"
				]
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"windows": {
				"command": "./waf.bat install",
				"problemMatcher": {
					"base": "$msCompile",
					"fileLocation": [
						"relative",
						"${workspaceFolder}/build"
					]
				}
			},
